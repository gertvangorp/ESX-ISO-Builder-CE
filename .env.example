# Copy to .env (chmod 600). The root password is hashed (SHA-512) at build time; only the hash goes into the ISO.
ESXI_ROOT_PASSWORD=ChangeMe-VMware1!
# or a ready-made hash instead (openssl passwd -6):
# ESXI_ROOT_HASH=$6$....

# Web UI / API login
UI_USER=admin
UI_PASSWORD=change-me-long-random

# Virtual media download (iDRAC Redfish InsertMedia / Comet) - read-only, separate account
MEDIA_AUTH=basic
MEDIA_USER=media
MEDIA_PASSWORD=change-me-too

# Base URL the iDRACs/Comets use to fetch the ISOs (ends up in the Ansible inventory)
PUBLIC_URL=https://esx-builder.example.com:8443
BUILDER_PORT=8443

# Optional: fast ISO download for iDRAC virtual media over plain HTTP (media-only listener, same media login).
# Restrict this port to the iDRAC/BMC subnet in your firewall.
MEDIA_HTTP_PORT=8080
MEDIA_URL=http://esx-builder.example.com:8080
# iDRAC9 does not log in on plain HTTP: allow the BMC subnet(s) on the HTTP listener without a login
MEDIA_HTTP_ALLOW=10.0.0.0/24
