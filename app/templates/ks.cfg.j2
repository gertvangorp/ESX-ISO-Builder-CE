# =============================================================================
# ESX kickstart – {{ h.fqdn }}
# Generated by the ESX ISO builder on {{ generated }}
# Profile {{ h.profile }}{% if h.description %} ({{ h.description }}){% endif %}, ESX {{ h.version }}
# =============================================================================
vmaccepteula

# Root password (SHA-512 hash, the clear text never lands in the ISO)
rootpw --iscrypted {{ root_hash }}

# ---- Disks ------------------------------------------------------------------
{% if h.clearpart == 'alldrives' %}
# Wipe every local disk: the boot disk, the NVMe tier device and the vSAN ESA disks
clearpart --alldrives --overwritevmfs
{% elif h.clearpart == 'bootdisk' %}
clearpart {{ boot_arg }} --overwritevmfs
{% endif %}
install {{ boot_arg }} {{ h.install_flags | join(' ') }}

# ---- Management network -----------------------------------------------------
network --bootproto=static --device={{ h.vmnic }}{% if h.vlan %} --vlanid={{ h.vlan }}{% endif %} --ip={{ h.ip }} --netmask={{ h.mask }} --gateway={{ h.gateway }} --hostname={{ h.fqdn }} --nameserver="{{ h.dns[:2] | join(',') }}" --addvmportgroup=0

reboot

# =============================================================================
# First boot: host settings that kickstart itself cannot set
# NOTE: ESX does NOT run this section on UEFI Secure Boot hosts (kickstart.log: "SecureBoot is enabled,
# skipping execution of scripts"). There, apply the settings after the install (vSphere API / your automation).
# =============================================================================
{% if not h.use_firstboot %}
# First-boot section left out (profile: use_firstboot: false) - apply the settings after the install.
{% else %}
%firstboot --interpreter=busybox
# Output goes to /var/log/esx-firstboot.log and to syslog (grep esx-firstboot /var/log/syslog.log);
# the file in /var/log does not always survive the final reboot.
LOG=/var/log/esx-firstboot.log
{
set -x
echo "===== ESX firstboot {{ h.fqdn }} $(date -u) ====="
NEED_REBOOT=0

# ---- Identity / DNS ---------------------------------------------------------
esxcli system hostname set --fqdn={{ h.fqdn }}
{% for d in h.dns_search %}
esxcli network ip dns search add --domain={{ d }}
{% endfor %}

# ---- NTP (VCF: same source on every component) ------------------------------
esxcli system ntp set{% for s in h.ntp %} --server={{ s }}{% endfor %} --enabled=true
# verify; if esxcli did not apply it during firstboot, fall back to ntp.conf + service policy "on"
if ! esxcli system ntp get | grep -q "{{ h.ntp[0] }}"; then
  echo "ntp: esxcli set did not stick - writing /etc/ntp.conf"
  cat > /etc/ntp.conf <<'NTPCONF'
restrict default nomodify notrap nopeer noquery
restrict 127.0.0.1
restrict -6 ::1
driftfile /etc/ntp.drift
{% for s in h.ntp %}server {{ s }} iburst
{% endfor %}NTPCONF
  /sbin/chkconfig ntpd on
  /etc/init.d/ntpd restart
fi
esxcli network firewall ruleset set -r ntpClient -e true
esxcli system ntp get

# ---- Services ---------------------------------------------------------------
{% if h.ssh %}
vim-cmd hostsvc/enable_ssh
vim-cmd hostsvc/start_ssh
{% endif %}
{% if h.esx_shell %}
vim-cmd hostsvc/enable_esx_shell
vim-cmd hostsvc/start_esx_shell
{% endif %}
{% if h.suppress_shell_warning %}
esxcli system settings advanced set -o /UserVars/SuppressShellWarning -i 1
{% endif %}
{% if h.advanced_settings %}

# ---- Advanced settings (profile {{ h.profile }}) -----------------------------
{% for a in h.advanced_settings %}
esxcli system settings advanced set -o {{ a.option }} {{ '-i' if (a.type | default('int')) == 'int' else '-s' }} {{ a.value | string | shquote }}
{% endfor %}
{% endif %}
{% if h.kernel_settings %}

# ---- Kernel settings (active after reboot) ----------------------------------
{% for k in h.kernel_settings %}
esxcli system settings kernel set -s {{ k.name }} -v {{ k.value | string | shquote }}
{% endfor %}
NEED_REBOOT=1
{% endif %}
{% if h.vmware_config %}

# ---- /etc/vmware/config – host-wide VMX defaults (idempotent, active after reboot)
{% for l in h.vmware_config %}
grep -qxF {{ l | shquote }} /etc/vmware/config || echo {{ l | shquote }} >> /etc/vmware/config
{% endfor %}
NEED_REBOOT=1
{% endif %}
{% if h.tier_disk %}

# ---- NVMe memory tiering ----------------------------------------------------
# Tier device = the only local disk that matches '{{ h.tier_disk }}' (device id / model / display name)
# and has NO partitions (the boot disk always has them). Ambiguous -> skipped, never guessed.
TIER_MATCH={{ h.tier_disk | upper | shquote }}
CANDS=""
for DEV in $(esxcli storage core device list | awk -v m="$TIER_MATCH" '
    /^[^ \t]/ { if (dev != "" && hit) print dev; dev = $1; hit = (index(toupper($0), m) > 0); next }
    /^[ \t]+(Display Name|Model|Vendor):/ { if (index(toupper($0), m) > 0) hit = 1 }
    END { if (dev != "" && hit) print dev }'); do
  if partedUtil getptbl "/vmfs/devices/disks/$DEV" 2>/dev/null | tail -n +3 | grep -q .; then
    echo "tiering: $DEV matches but has partitions - skipped"
  else
    CANDS="$CANDS $DEV"
  fi
done
set -- $CANDS
if [ $# -eq 1 ]; then
  TIER_DEV=$1
  echo "tiering: using $TIER_DEV ({{ h.tier_pct }}% of DRAM)"
{% if memtier_v2 %}
  # ESX 9.1+: one command; the host must be in maintenance mode, no reboot needed
  esxcli system maintenanceMode set --enable true
  esxcli memtier enable -d "/vmfs/devices/disks/$TIER_DEV" -r {{ h.tier_pct }}
  esxcli system maintenanceMode set --enable false
{% else %}
  # ESXi 8.0U3 / ESX 9.0: legacy method, active after a reboot
  esxcli system tierdevice create -d "/vmfs/devices/disks/$TIER_DEV"
  esxcli system settings kernel set -s MemoryTiering -v TRUE
  esxcli system settings advanced set -o /Mem/TierNvmePct -i {{ h.tier_pct }}
  esxcli system tierdevice list
  NEED_REBOOT=1
{% endif %}
else
  echo "tiering: $# candidate(s) for '$TIER_MATCH' ($CANDS) - NOT configured, use a serial number in TierDisk"
fi
{% endif %}
{% if h.firstboot_commands %}

# ---- Extra commands (profile {{ h.profile }}) --------------------------------
{% for c in h.firstboot_commands %}
{{ c }}
{% endfor %}
{% endif %}
{% if h.regenerate_certificates %}

# ---- Self-signed certificate with CN = FQDN (VCF host validation) -----------
/sbin/generate-certificates
NEED_REBOOT=1
{% endif %}

# persist /etc changes in state.tgz before the reboot
/sbin/auto-backup.sh
echo "===== ESX firstboot done, reboot=$NEED_REBOOT ====="
if [ "$NEED_REBOOT" = 1 ]; then
  sleep 5   # let tee flush the log
  reboot
fi
} 2>&1 | tee -a "$LOG" | logger -t esx-firstboot
{% endif %}
